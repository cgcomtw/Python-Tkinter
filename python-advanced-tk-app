#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Advanced Tkinter App - 單檔進階範例
- File menu: 開啟 CSV、最近開啟、離開
- Edit menu: 偏好設定（主題、啟動開啟上次檔案）
- View menu: 深色/淺色主題、全螢幕切換
- Tools menu: 背景工作
- Help menu: 關於
"""

import csv
import json
import os
import queue
import threading
import time
import tkinter as tk
from tkinter import ttk, filedialog, messagebox

APP_NAME = "Tk Advanced Demo"
PREF_FILE = os.path.join(os.path.expanduser("~"), ".tk_advanced_demo_prefs.json")
MAX_RECENTS = 8

# -----------------------------
# 偏好儲存/載入
# -----------------------------
DEFAULT_PREFS = {
    "theme": "light",                # "light" or "dark"
    "geometry": "1000x680+100+60",   # 視窗大小/位置
    "start_fullscreen": False,
    "open_last_file_on_start": False,
    "recent_files": []
}

def load_prefs():
    try:
        if os.path.exists(PREF_FILE):
            with open(PREF_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                prefs = DEFAULT_PREFS.copy()
                prefs.update(data)
                return prefs
    except Exception:
        pass
    return DEFAULT_PREFS.copy()

def save_prefs(prefs):
    try:
        with open(PREF_FILE, "w", encoding="utf-8") as f:
            json.dump(prefs, f, ensure_ascii=False, indent=2)
    except Exception as e:
        print("Failed to save prefs:", e)

# -----------------------------
# 主題樣式
# -----------------------------
def apply_theme(root, style, theme: str):
    """深/淺色主題（ttk style）"""
    bg_light = "#F7F7F7"
    fg_light = "#222222"
    sel_light = "#E0E0E0"

    bg_dark = "#1E1F22"
    fg_dark = "#EAEAEA"
    sel_dark = "#2A2B2E"

    if theme == "dark":
        bg, fg, sel = bg_dark, fg_dark, sel_dark
    else:
        bg, fg, sel = bg_light, fg_light, sel_light

    root.configure(bg=bg)

    style.theme_use("default")
    style.configure(".", background=bg, foreground=fg, fieldbackground=bg)
    style.configure("Treeview", background=bg, fieldbackground=bg, foreground=fg, rowheight=24)
    style.map("Treeview", background=[("selected", sel)])
    style.configure("TEntry", fieldbackground=bg)
    style.configure("TLabel", background=bg, foreground=fg)
    style.configure("TFrame", background=bg)
    style.configure("TNotebook", background=bg, borderwidth=0)
    style.configure("TNotebook.Tab", background=bg, foreground=fg, padding=(12, 6))
    style.map("TNotebook.Tab", background=[("selected", sel)])
    style.configure("TButton", padding=(10, 6))
    style.configure("Horizontal.TProgressbar", troughcolor=bg, background=("#4C8BF5" if theme=="light" else "#6A9BFF"))

    # Menu 顏色（原生 Menu 客製有限，這裡只處理 tearoff=0 的一致性）
    root.option_add("*Menu*background", bg)
    root.option_add("*Menu*foreground", fg)
    root.option_add("*Menu*activeBackground", sel)
    root.option_add("*Menu*activeForeground", fg)

# -----------------------------
# 資料表模型
# -----------------------------
class TableModel:
    def __init__(self):
        self.headers = []
        self.rows = []

    def load_csv(self, path):
        encodings = ["utf-8-sig", "utf-8", "big5", "cp950"]
        last_err = None
        for enc in encodings:
            try:
                with open(path, "r", encoding=enc, newline="") as f:
                    reader = csv.reader(f)
                    data = list(reader)
                break
            except Exception as e:
                last_err = e
        else:
            raise last_err

        if not data:
            self.headers = []
            self.rows = []
            return

        self.headers = data[0]
        self.rows = data[1:]

    def filtered_sorted_rows(self, keyword: str, sort_key=None, reverse=False):
        def match(row):
            if not keyword:
                return True
            kw = keyword.lower()
            for cell in row:
                if kw in str(cell).lower():
                    return True
            return False

        result = [r for r in self.rows if match(r)]
        if sort_key is not None:
            try:
                idx = sort_key
                result.sort(key=lambda r: r[idx], reverse=reverse)
            except Exception:
                pass
        return result

# -----------------------------
# 背景工作（示範）
# -----------------------------
class BackgroundWorker:
    def __init__(self):
        self._thread = None
        self._q = queue.Queue()
        self._cancel = threading.Event()

    def start(self, steps=100, delay=0.03):
        if self.is_running:
            return
        self._cancel.clear()
        self._thread = threading.Thread(target=self._run, args=(steps, delay), daemon=True)
        self._thread.start()

    def cancel(self):
        self._cancel.set()

    @property
    def is_running(self):
        return self._thread is not None and self._thread.is_alive()

    def get_queue(self):
        return self._q

    def _run(self, steps, delay):
        try:
            for i in range(steps + 1):
                if self._cancel.is_set():
                    self._q.put(("log", "已中止背景工作"))
                    self._q.put(("done", None))
                    return
                # 模擬重工作業
                time.sleep(delay)
                self._q.put(("progress", i / steps))
                if i % 10 == 0:
                    self._q.put(("log", f"背景工作進度: {i}/{steps}"))
            self._q.put(("log", "背景工作完成"))
            self._q.put(("done", None))
        except Exception as e:
            self._q.put(("error", str(e)))
            self._q.put(("done", None))

# -----------------------------
# 主視窗
# -----------------------------
class App(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title(APP_NAME)
        self.minsize(900, 560)

        self.prefs = load_prefs()
        try:
            self.geometry(self.prefs.get("geometry", DEFAULT_PREFS["geometry"]))
        except Exception:
            pass

        self.style = ttk.Style(self)
        apply_theme(self, self.style, self.prefs.get("theme", "light"))

        # 狀態
        self.model = TableModel()
        self.current_file = None
        self.sort_column_index = None
        self.sort_reverse = False

        # UI
        self._build_menu()
        self._build_toolbar()
        self._build_main()
        self._build_statusbar()
        self._bind_shortcuts()

        # 背景工作
        self.worker = BackgroundWorker()
        self.after(100, self._poll_worker_queue)

        # 啟動全螢幕（選擇性）
        if self.prefs.get("start_fullscreen"):
            self.attributes("-fullscreen", True)

        # 啟動時自動開啟上次檔案（選擇性）
        if self.prefs.get("open_last_file_on_start"):
            recents = self.prefs.get("recent_files", [])
            if recents:
                last = recents[0]
                if os.path.exists(last):
                    self.open_csv(last)

        self._set_status("就緒")

        self.protocol("WM_DELETE_WINDOW", self.on_exit)

    # ---------- UI: Menu ----------
    def _build_menu(self):
        menubar = tk.Menu(self, tearoff=0)

        # File
        file_menu = tk.Menu(menubar, tearoff=0)
        file_menu.add_command(label="開啟…\tCtrl+O", command=self.cmd_open)
        # 最近開啟
        self.recent_menu = tk.Menu(file_menu, tearoff=0)
        file_menu.add_cascade(label="最近開啟", menu=self.recent_menu)
        file_menu.add_separator()
        file_menu.add_command(label="離開\tCtrl+Q", command=self.on_exit)
        menubar.add_cascade(label="檔案", menu=file_menu)

        # Edit
        edit_menu = tk.Menu(menubar, tearoff=0)
        edit_menu.add_command(label="偏好設定…", command=self.cmd_preferences)
        menubar.add_cascade(label="編輯", menu=edit_menu)

        # View
        view_menu = tk.Menu(menubar, tearoff=0)
        view_menu.add_command(label="切換深色/淺色主題", command=self.toggle_theme)
        view_menu.add_command(label="全螢幕\tF11", command=self.toggle_fullscreen)
        menubar.add_cascade(label="檢視", menu=view_menu)

        # Tools
        tools_menu = tk.Menu(menubar, tearoff=0)
        tools_menu.add_command(label="執行背景工作", command=self.cmd_start_worker)
        tools_menu.add_command(label="中止背景工作", command=self.cmd_cancel_worker)
        menubar.add_cascade(label="工具", menu=tools_menu)

        # Help
        help_menu = tk.Menu(menubar, tearoff=0)
        help_menu.add_command(label="關於…", command=self.cmd_about)
        menubar.add_cascade(label="說明", menu=help_menu)

        self.config(menu=menubar)
        self._refresh_recent_menu()

    # ---------- UI: Toolbar ----------
    def _build_toolbar(self):
        self.toolbar = ttk.Frame(self)
        self.toolbar.pack(side=tk.TOP, fill=tk.X)

        btn_open = ttk.Button(self.toolbar, text="開啟 CSV", command=self.cmd_open)
        btn_open.pack(side=tk.LEFT, padx=6, pady=6)

        ttk.Separator(self.toolbar, orient=tk.VERTICAL).pack(side=tk.LEFT, fill=tk.Y, padx=4)

        ttk.Label(self.toolbar, text="關鍵字過濾：").pack(side=tk.LEFT, padx=(8, 4))
        self.var_filter = tk.StringVar()
        ent_filter = ttk.Entry(self.toolbar, textvariable=self.var_filter, width=24)
        ent_filter.pack(side=tk.LEFT, padx=(0, 8), pady=6)
        ent_filter.bind("<Return>", lambda e: self.refresh_table())

        btn_apply = ttk.Button(self.toolbar, text="套用", command=self.refresh_table)
        btn_apply.pack(side=tk.LEFT, padx=(0, 6))

        btn_clear = ttk.Button(self.toolbar, text="清除", command=lambda: (self.var_filter.set(""), self.refresh_table()))
        btn_clear.pack(side=tk.LEFT)

        ttk.Separator(self.toolbar, orient=tk.VERTICAL).pack(side=tk.LEFT, fill=tk.Y, padx=4)

        self.prg = ttk.Progressbar(self.toolbar, length=180, mode="determinate")
        self.prg.pack(side=tk.RIGHT, padx=8)

    # ---------- UI: Main (Paned + Notebook + Tree) ----------
    def _build_main(self):
        paned = ttk.Panedwindow(self, orient=tk.HORIZONTAL)
        paned.pack(fill=tk.BOTH, expand=True)

        # 左側：Notebook（可以放多個頁籤；此處示範一個 Log）
        left = ttk.Frame(paned)
        paned.add(left, weight=1)

        self.nb = ttk.Notebook(left)
        self.nb.pack(fill=tk.BOTH, expand=True, padx=4, pady=4)

        self.log_text = tk.Text(self.nb, height=6, wrap="word", state="disabled", borderwidth=0)
        self.nb.add(self.log_text, text="Log")

        # 右側：表格
        right = ttk.Frame(paned)
        paned.add(right, weight=3)

        columns = [f"C{i}" for i in range(1, 9)]  # 最多先準備 8 欄（動態調整）
        self.tree = ttk.Treeview(right, columns=columns, show="headings", selectmode="browse")
        self.tree.pack(fill=tk.BOTH, expand=True, padx=4, pady=4)

        vsb = ttk.Scrollbar(self.tree, orient="vertical", command=self.tree.yview)
        hsb = ttk.Scrollbar(self.tree, orient="horizontal", command=self.tree.xview)
        self.tree.configure(yscroll=vsb.set, xscroll=hsb.set)
        vsb.pack(side=tk.RIGHT, fill=tk.Y)
        hsb.pack(side=tk.BOTTOM, fill=tk.X)

        # 預設欄寬與排序綁定
        for i, c in enumerate(columns):
            self.tree.heading(c, text=c, command=lambda idx=i: self._on_column_click(idx))
            self.tree.column(c, width=120, anchor="w")

        # 右鍵選單（複製儲存格）
        self.tree.bind("<Button-3>", self._popup_tree_menu)
        self._tree_popup = tk.Menu(self, tearoff=0)
        self._tree_popup.add_command(label="複製儲存格文字", command=self._copy_cell_text)

    # ---------- UI: Status Bar ----------
    def _build_statusbar(self):
        self.status = ttk.Label(self, text="", anchor="w")
        self.status.pack(side=tk.BOTTOM, fill=tk.X, padx=6, pady=4)

    # ---------- 事件/快捷鍵 ----------
    def _bind_shortcuts(self):
        self.bind("<Control-o>", lambda e: self.cmd_open())
        self.bind("<Control-q>", lambda e: self.on_exit())
        self.bind("<Control-f>", lambda e: self._focus_filter())
        self.bind("<F11>", lambda e: self.toggle_fullscreen())

    def _focus_filter(self):
        for child in self.toolbar.winfo_children():
            if isinstance(child, ttk.Entry):
                child.focus_set()
                child.select_range(0, tk.END)
                break

    # ---------- 檔案操作 ----------
    def cmd_open(self):
        path = filedialog.askopenfilename(
            title="開啟 CSV",
            filetypes=[("CSV 檔案", "*.csv"), ("所有檔案", "*.*")]
        )
        if not path:
            return
        self.open_csv(path)

    def open_csv(self, path):
        try:
            self.model.load_csv(path)
        except Exception as e:
            messagebox.showerror("開啟失敗", f"讀取檔案失敗：\n{e}")
            return

        self.current_file = path
        self._update_title()
        self._push_recent(path)
        self._refresh_recent_menu()
        self.refresh_table()
        self._log(f"已載入：{path}")
        self._set_status(f"載入完成（{len(self.model.rows)} 筆）")

    def _push_recent(self, path):
        recents = [p for p in self.prefs.get("recent_files", []) if p != path]
        recents.insert(0, path)
        self.prefs["recent_files"] = recents[:MAX_RECENTS]
        save_prefs(self.prefs)

    def _refresh_recent_menu(self):
        self.recent_menu.delete(0, tk.END)
        recents = self.prefs.get("recent_files", [])
        if not recents:
            self.recent_menu.add_command(label="（無）", state="disabled")
        else:
            for p in recents:
                label = p if len(p) < 60 else "…" + p[-59:]
                self.recent_menu.add_command(label=label, command=lambda path=p: self.open_csv(path))
            self.recent_menu.add_separator()
            self.recent_menu.add_command(label="清除清單", command=self._clear_recents)

    def _clear_recents(self):
        self.prefs["recent_files"] = []
        save_prefs(self.prefs)
        self._refresh_recent_menu()

    # ---------- 表格顯示/排序/過濾 ----------
    def refresh_table(self):
        # 先清空欄位與列
        for c in self.tree["columns"]:
            self.tree.heading(c, text=c, command=None)
        self.tree.delete(*self.tree.get_children())

        if not self.model.headers:
            # 無資料，恢復預設欄頭
            columns = [f"C{i}" for i in range(1, 9)]
            self.tree.configure(columns=columns)
            for i, c in enumerate(columns):
                self.tree.heading(c, text=c, command=lambda idx=i: self._on_column_click(idx))
                self.tree.column(c, width=120, anchor="w")
            return

        # 依據 CSV 動態配置欄位
        columns = [f"COL{i}" for i in range(len(self.model.headers))]
        self.tree.configure(columns=columns)
        for i, hdr in enumerate(self.model.headers):
            text = str(hdr) if hdr else f"欄位{i+1}"
            self.tree.heading(columns[i], text=text, command=lambda idx=i: self._on_column_click(idx))
            self.tree.column(columns[i], width=140, anchor="w")

        # 過濾 + 排序
        keyword = self.var_filter.get().strip()
        rows = self.model.filtered_sorted_rows(
            keyword=keyword,
            sort_key=self.sort_column_index,
            reverse=self.sort_reverse
        )

        # 填入資料
        for r in rows:
            values = [str(c) for c in r]
            self.tree.insert("", tk.END, values=values)

        self._set_status(f"顯示 {len(rows)} / 全部 {len(self.model.rows)} 筆；"
                         f"{'降冪' if self.sort_reverse else '升冪'}"
                         f"{f'（排序欄：{self.model.headers[self.sort_column_index]}）' if self.sort_column_index is not None else ''}")

    def _on_column_click(self, col_idx):
        if self.sort_column_index == col_idx:
            self.sort_reverse = not self.sort_reverse
        else:
            self.sort_column_index = col_idx
            self.sort_reverse = False
        self.refresh_table()

    def _popup_tree_menu(self, event):
        try:
            self.tree.selection_set(self.tree.identify_row(event.y))
            self._tree_popup.tk_popup(event.x_root, event.y_root)
        finally:
            self._tree_popup.grab_release()

    def _copy_cell_text(self):
        sel = self.tree.selection()
        if not sel:
            return
        item = sel[0]
        col = self.tree.identify_column(self.winfo_pointerx() - self.tree.winfo_rootx())
        try:
            col_index = int(col[1:]) - 1
        except Exception:
            col_index = 0
        values = self.tree.item(item, "values")
        text = values[col_index] if 0 <= col_index < len(values) else ""
        self.clipboard_clear()
        self.clipboard_append(text)
        self._set_status("已複製儲存格文字")

    # ---------- 工具：背景工作 ----------
    def cmd_start_worker(self):
        if self.worker.is_running:
            messagebox.showinfo("背景工作", "工作執行中，請先中止或等待完成。")
            return
        self.prg["value"] = 0
        self.worker.start(steps=180, delay=0.02)
        self._log("背景工作已開始…")
        self._set_status("背景工作執行中…")

    def cmd_cancel_worker(self):
        if self.worker.is_running:
            self.worker.cancel()
            self._set_status("嘗試中止背景工作…")

    def _poll_worker_queue(self):
        q = self.worker.get_queue()
        try:
            while True:
                typ, payload = q.get_nowait()
                if typ == "progress":
                    self.prg["value"] = int(payload * 100)
                elif typ == "log":
                    self._log(payload)
                elif typ == "error":
                    self._log(f"[錯誤] {payload}")
                    messagebox.showerror("背景工作錯誤", payload)
                elif typ == "done":
                    self._set_status("背景工作已結束")
        except queue.Empty:
            pass
        self.after(50, self._poll_worker_queue)

    # ---------- 偏好/主題/視窗 ----------
    def cmd_preferences(self):
        dlg = PrefDialog(self, self.prefs.copy())
        self.wait_window(dlg)
        if dlg.result is not None:
            self.prefs.update(dlg.result)
            save_prefs(self.prefs)
            apply_theme(self, self.style, self.prefs["theme"])
            self._set_status("已套用偏好設定")

    def toggle_theme(self):
        t = self.prefs.get("theme", "light")
        self.prefs["theme"] = "dark" if t == "light" else "light"
        save_prefs(self.prefs)
        apply_theme(self, self.style, self.prefs["theme"])

    def toggle_fullscreen(self):
        fs = bool(self.attributes("-fullscreen"))
        self.attributes("-fullscreen", not fs)

    # ---------- 其他 ----------
    def _update_title(self):
        name = os.path.basename(self.current_file) if self.current_file else ""
        self.title(f"{APP_NAME} - {name}" if name else APP_NAME)

    def _set_status(self, text):
        self.status.config(text=text)

    def _log(self, text):
        self.log_text.configure(state="normal")
        self.log_text.insert(tk.END, text + "\n")
        self.log_text.see(tk.END)
        self.log_text.configure(state="disabled")

    def cmd_about(self):
        messagebox.showinfo("關於", f"{APP_NAME}\n\nTkinter 進階範例\n© 2025")

    def on_exit(self):
        # 記住視窗大小
        try:
            if not bool(self.attributes("-fullscreen")):
                self.prefs["geometry"] = self.geometry()
        except Exception:
            pass
        save_prefs(self.prefs)
        self.destroy()

# -----------------------------
# 偏好設定對話框
# -----------------------------
class PrefDialog(tk.Toplevel):
    def __init__(self, master, prefs):
        super().__init__(master)
        self.title("偏好設定")
        self.resizable(False, False)
        self.transient(master)
        self.grab_set()

        self.result = None

        frm = ttk.Frame(self)
        frm.pack(padx=16, pady=16, fill=tk.BOTH, expand=True)

        self.var_theme = tk.StringVar(value=prefs.get("theme", "light"))
        self.var_fullscreen = tk.BooleanVar(value=prefs.get("start_fullscreen", False))
        self.var_openlast = tk.BooleanVar(value=prefs.get("open_last_file_on_start", False))

        row = 0
        ttk.Label(frm, text="主題：").grid(row=row, column=0, sticky="w")
        cb = ttk.Combobox(frm, state="readonly", values=["light", "dark"], textvariable=self.var_theme, width=12)
        cb.grid(row=row, column=1, sticky="w", padx=8, pady=4)
        row += 1

        ttk.Checkbutton(frm, text="啟動時全螢幕", variable=self.var_fullscreen).grid(row=row, column=0, columnspan=2, sticky="w", pady=4)
        row += 1
        ttk.Checkbutton(frm, text="啟動時自動開啟上次檔案", variable=self.var_openlast).grid(row=row, column=0, columnspan=2, sticky="w", pady=4)
        row += 1

        btns = ttk.Frame(frm)
        btns.grid(row=row, column=0, columnspan=2, pady=(12, 0), sticky="e")
        ttk.Button(btns, text="取消", command=self.destroy).pack(side=tk.RIGHT, padx=6)
        ttk.Button(btns, text="確定", command=self._ok).pack(side=tk.RIGHT)

        self.bind("<Return>", lambda e: self._ok())
        self.bind("<Escape>", lambda e: self.destroy())

    def _ok(self):
        self.result = {
            "theme": self.var_theme.get(),
            "start_fullscreen": bool(self.var_fullscreen.get()),
            "open_last_file_on_start": bool(self.var_openlast.get())
        }
        self.destroy()

# -----------------------------
# 進入點
# -----------------------------
def main():
    app = App()
    app.mainloop()

if __name__ == "__main__":
    main()
