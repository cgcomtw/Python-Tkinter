# -*- coding: utf-8 -*-
"""
Advanced Qt App (PySide6) - 單檔進階範例
- File: 開啟 CSV、最近開啟、離開
- Edit: 偏好設定（主題/啟動全螢幕/開啟上次檔案）
- View: 深色/淺色主題、全螢幕
- Tools: 背景工作（可取消）
- Help: 關於
"""

import csv
import json
import os
import sys
import typing as T

from PySide6.QtCore import (
    Qt, QRegularExpression, QSortFilterProxyModel, QAbstractTableModel,
    QModelIndex, QThread, Signal, QObject, QSize
)
from PySide6.QtGui import QAction, QKeySequence, QPalette
from PySide6.QtWidgets import (
    QApplication, QMainWindow, QFileDialog, QMessageBox, QToolBar, QStatusBar,
    QSplitter, QWidget, QVBoxLayout, QTabWidget, QTextEdit, QTableView,
    QMenu, QLineEdit, QLabel, QProgressBar, QDialog, QFormLayout, QComboBox,
    QCheckBox, QDialogButtonBox, QStyleFactory
)

APP_NAME = "Qt Advanced Demo"
PREF_FILE = os.path.join(os.path.expanduser("~"), ".qt_advanced_demo_prefs.json")
MAX_RECENTS = 8

# -----------------------------
# 偏好設定
# -----------------------------
DEFAULT_PREFS = {
    "theme": "light",                 # "light" or "dark"
    "geometry": None,                 # 由 Qt 儲存/還原
    "window_state": None,             # 由 Qt 儲存/還原
    "start_fullscreen": False,
    "open_last_file_on_start": False,
    "recent_files": []
}

def load_prefs() -> dict:
    try:
        if os.path.exists(PREF_FILE):
            with open(PREF_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                prefs = DEFAULT_PREFS.copy()
                prefs.update(data)
                return prefs
    except Exception:
        pass
    return DEFAULT_PREFS.copy()

def save_prefs(prefs: dict):
    try:
        with open(PREF_FILE, "w", encoding="utf-8") as f:
            json.dump(prefs, f, ensure_ascii=False, indent=2)
    except Exception as e:
        print("Failed to save prefs:", e)

# -----------------------------
# 主題（淺/深）
# -----------------------------
def apply_theme(app: QApplication, theme: str):
    app.setStyle("Fusion")
    pal = app.palette()

    if theme == "dark":
        # 基於 Qt 官方深色範例調整
        dark = QPalette()
        dark.setColor(QPalette.Window,               Qt.black.darker(250))   # 背景深灰
        dark.setColor(QPalette.WindowText,           Qt.white)
        dark.setColor(QPalette.Base,                 Qt.black.darker(230))
        dark.setColor(QPalette.AlternateBase,        Qt.black.darker(200))
        dark.setColor(QPalette.ToolTipBase,          Qt.white)
        dark.setColor(QPalette.ToolTipText,          Qt.white)
        dark.setColor(QPalette.Text,                 Qt.white)
        dark.setColor(QPalette.Button,               Qt.black.darker(250))
        dark.setColor(QPalette.ButtonText,           Qt.white)
        dark.setColor(QPalette.BrightText,           Qt.red)
        dark.setColor(QPalette.Link,                 Qt.cyan)
        dark.setColor(QPalette.Highlight,            Qt.gray)
        dark.setColor(QPalette.HighlightedText,      Qt.white)
        app.setPalette(dark)
    else:
        app.setPalette(QStyleFactory.create("Fusion").standardPalette())

# -----------------------------
# 資料模型
# -----------------------------
class CsvTableModel(QAbstractTableModel):
    def __init__(self, headers: T.List[str] = None, rows: T.List[T.List[str]] = None, parent=None):
        super().__init__(parent)
        self.headers = headers or []
        self.rows = rows or []

    def set_data(self, headers: T.List[str], rows: T.List[T.List[str]]):
        self.beginResetModel()
        self.headers = headers
        self.rows = rows
        self.endResetModel()

    def rowCount(self, parent=QModelIndex()) -> int:
        return 0 if parent.isValid() else len(self.rows)

    def columnCount(self, parent=QModelIndex()) -> int:
        return 0 if parent.isValid() else len(self.headers)

    def data(self, index: QModelIndex, role=Qt.DisplayRole):
        if not index.isValid():
            return None
        if role in (Qt.DisplayRole, Qt.EditRole):
            r, c = index.row(), index.column()
            try:
                return "" if self.rows[r][c] is None else str(self.rows[r][c])
            except Exception:
                return ""
        return None

    def headerData(self, section, orientation, role=Qt.DisplayRole):
        if role != Qt.DisplayRole:
            return None
        if orientation == Qt.Horizontal:
            try:
                return self.headers[section] if self.headers[section] else f"欄位{section+1}"
            except Exception:
                return f"欄位{section+1}"
        else:
            return section + 1

# 自訂 Proxy：全欄位關鍵字過濾
class KeywordFilterProxy(QSortFilterProxyModel):
    def __init__(self, parent=None):
        super().__init__(parent)
        self._pattern = ""
        self.setFilterCaseSensitivity(Qt.CaseInsensitive)
        self.setFilterKeyColumn(-1)  # 全欄位

    def setKeyword(self, text: str):
        self._pattern = text.strip()
        self.invalidateFilter()

    def filterAcceptsRow(self, source_row: int, source_parent: QModelIndex) -> bool:
        if not self._pattern:
            return True
        cols = self.sourceModel().columnCount()
        for c in range(cols):
            idx = self.sourceModel().index(source_row, c, source_parent)
            val = self.sourceModel().data(idx, Qt.DisplayRole)
            if val and self._pattern.lower() in str(val).lower():
                return True
        return False

# -----------------------------
# 背景工作 (QThread)
# -----------------------------
class WorkerSignals(QObject):
    progress = Signal(float)     # 0.0~1.0
    log = Signal(str)
    error = Signal(str)
    done = Signal()

class BackgroundWorker(QObject):
    def __init__(self, steps=100, delay_ms=30, parent=None):
        super().__init__(parent)
        self.signals = WorkerSignals()
        self._cancel = False
        self.steps = steps
        self.delay_ms = delay_ms

    def cancel(self):
        self._cancel = True

    def run(self):
        from time import sleep
        try:
            for i in range(self.steps + 1):
                if self._cancel:
                    self.signals.log.emit("已中止背景工作")
                    self.signals.done.emit()
                    return
                sleep(self.delay_ms / 1000.0)
                self.signals.progress.emit(i / self.steps)
                if i % 10 == 0:
                    self.signals.log.emit(f"背景工作進度: {i}/{self.steps}")
            self.signals.log.emit("背景工作完成")
            self.signals.done.emit()
        except Exception as e:
            self.signals.error.emit(str(e))
            self.signals.done.emit()

# -----------------------------
# 偏好設定對話框
# -----------------------------
class PrefDialog(QDialog):
    def __init__(self, prefs: dict, parent=None):
        super().__init__(parent)
        self.setWindowTitle("偏好設定")
        self.setModal(True)
        self._prefs = prefs
        lay = QFormLayout(self)

        self.cmb_theme = QComboBox()
        self.cmb_theme.addItems(["light", "dark"])
        self.cmb_theme.setCurrentText(prefs.get("theme", "light"))

        self.chk_full = QCheckBox("啟動時全螢幕")
        self.chk_full.setChecked(bool(prefs.get("start_fullscreen", False)))

        self.chk_openlast = QCheckBox("啟動時自動開啟上次檔案")
        self.chk_openlast.setChecked(bool(prefs.get("open_last_file_on_start", False)))

        lay.addRow("主題：", self.cmb_theme)
        lay.addRow(self.chk_full)
        lay.addRow(self.chk_openlast)

        btns = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        btns.accepted.connect(self.accept)
        btns.rejected.connect(self.reject)
        lay.addWidget(btns)

    def result_prefs(self) -> dict:
        return {
            "theme": self.cmb_theme.currentText(),
            "start_fullscreen": self.chk_full.isChecked(),
            "open_last_file_on_start": self.chk_openlast.isChecked()
        }

# -----------------------------
# 主視窗
# -----------------------------
class MainWindow(QMainWindow):
    def __init__(self, app: QApplication):
        super().__init__()
        self.app = app
        self.setWindowTitle(APP_NAME)
        self.resize(1000, 680)

        self.prefs = load_prefs()
        apply_theme(self.app, self.prefs.get("theme", "light"))

        # 狀態
        self.current_file: T.Optional[str] = None
        self.model = CsvTableModel()
        self.proxy = KeywordFilterProxy()
        self.proxy.setSourceModel(self.model)

        self.thread: T.Optional[QThread] = None
        self.worker: T.Optional[BackgroundWorker] = None

        # 介面
        self._build_menu()
        self._build_toolbar()
        self._build_central()
        self._build_statusbar()
        self._bind_shortcuts()

        # 還原視窗狀態
        self._restore_window_state()

        # 啟動時自動開啟上次檔案
        if self.prefs.get("open_last_file_on_start"):
            recents = self.prefs.get("recent_files", [])
            if recents and os.path.exists(recents[0]):
                self.open_csv(recents[0])

        # 啟動全螢幕
        if self.prefs.get("start_fullscreen"):
            self._toggle_fullscreen(force=True)

    # ---------- UI 建置 ----------
    def _build_menu(self):
        mb = self.menuBar()

        # File
        m_file = mb.addMenu("檔案(&F)")
        act_open = QAction("開啟…", self, shortcut=QKeySequence.Open, triggered=self.cmd_open)
        act_quit = QAction("離開", self, shortcut=QKeySequence.Quit, triggered=self.close)
        m_file.addAction(act_open)

        self.m_recent = m_file.addMenu("最近開啟")
        self._refresh_recent_menu()
        m_file.addSeparator()
        m_file.addAction(act_quit)

        # Edit
        m_edit = mb.addMenu("編輯(&E)")
        act_pref = QAction("偏好設定…", self, triggered=self.cmd_preferences)
        m_edit.addAction(act_pref)

        # View
        m_view = mb.addMenu("檢視(&V)")
        act_theme = QAction("切換深色/淺色主題", self, triggered=self.toggle_theme)
        act_full = QAction("全螢幕", self, shortcut=Qt.Key_F11, triggered=self._toggle_fullscreen)
        m_view.addAction(act_theme)
        m_view.addAction(act_full)

        # Tools
        m_tools = mb.addMenu("工具(&T)")
        act_run = QAction("執行背景工作", self, triggered=self.cmd_start_worker)
        act_cancel = QAction("中止背景工作", self, triggered=self.cmd_cancel_worker)
        m_tools.addAction(act_run)
        m_tools.addAction(act_cancel)

        # Help
        m_help = mb.addMenu("說明(&H)")
        act_about = QAction("關於…", self, triggered=self.cmd_about)
        m_help.addAction(act_about)

    def _build_toolbar(self):
        tb = QToolBar("工具列")
        tb.setIconSize(QSize(16, 16))
        self.addToolBar(tb)

        btn_open = QAction("開啟 CSV", self)
        btn_open.triggered.connect(self.cmd_open)
        tb.addAction(btn_open)

        tb.addSeparator()

        lbl = QLabel("關鍵字過濾：")
        tb.addWidget(lbl)
        self.ed_filter = QLineEdit()
        self.ed_filter.setPlaceholderText("按 Enter 套用")
        self.ed_filter.returnPressed.connect(self.apply_filter)
        tb.addWidget(self.ed_filter)

        btn_apply = QAction("套用", self)
        btn_apply.triggered.connect(self.apply_filter)
        tb.addAction(btn_apply)

        btn_clear = QAction("清除", self)
        def _clear():
            self.ed_filter.clear()
            self.apply_filter()
        btn_clear.triggered.connect(_clear)
        tb.addAction(btn_clear)

        # 進度條放右側
        tb.addSeparator()
        self.prg = QProgressBar()
        self.prg.setRange(0, 100)
        self.prg.setValue(0)
        self.prg.setFixedWidth(200)
        tb.addWidget(self.prg)

    def _build_central(self):
        splitter = QSplitter(Qt.Horizontal)
        left = QWidget()
        left_lay = QVBoxLayout(left)
        self.tabs = QTabWidget()
        self.txt_log = QTextEdit()
        self.txt_log.setReadOnly(True)
        self.tabs.addTab(self.txt_log, "Log")
        left_lay.addWidget(self.tabs)

        right = QWidget()
        right_lay = QVBoxLayout(right)
        self.table = QTableView()
        self.table.setModel(self.proxy)
        self.table.setSortingEnabled(True)
        self.table.setSelectionBehavior(QTableView.SelectionBehavior.SelectItems)
        self.table.setContextMenuPolicy(Qt.CustomContextMenu)
        self.table.customContextMenuRequested.connect(self._table_context_menu)
        right_lay.addWidget(self.table)

        splitter.addWidget(left)
        splitter.addWidget(right)
        splitter.setStretchFactor(0, 1)
        splitter.setStretchFactor(1, 3)

        cw = QWidget()
        lay = QVBoxLayout(cw)
        lay.addWidget(splitter)
        self.setCentralWidget(cw)

    def _build_statusbar(self):
        sb = QStatusBar()
        self.setStatusBar(sb)
        self._set_status("就緒")

    def _bind_shortcuts(self):
        # 額外：Ctrl+F 聚焦過濾框
        act_focus = QAction(self)
        act_focus.setShortcut(QKeySequence.Find)
        act_focus.triggered.connect(self._focus_filter)
        self.addAction(act_focus)

    # ---------- 檔案 ----------
    def cmd_open(self):
        path, _ = QFileDialog.getOpenFileName(self, "開啟 CSV", "", "CSV 檔案 (*.csv);;所有檔案 (*.*)")
        if not path:
            return
        self.open_csv(path)

    def open_csv(self, path: str):
        try:
            headers, rows = self._load_csv_with_guess(path)
        except Exception as e:
            QMessageBox.critical(self, "開啟失敗", f"讀取檔案失敗：\n{e}")
            return

        self.model.set_data(headers, rows)
        self.current_file = path
        self._update_title()
        self._push_recent(path)
        self._refresh_recent_menu()
        self.table.resizeColumnsToContents()
        self._log(f"已載入：{path}")
        self._set_status(f"載入完成（{len(rows)} 筆）")

    def _load_csv_with_guess(self, path: str) -> T.Tuple[T.List[str], T.List[T.List[str]]]:
        encodings = ["utf-8-sig", "utf-8", "big5", "cp950"]
        last_err = None
        for enc in encodings:
            try:
                with open(path, "r", encoding=enc, newline="") as f:
                    reader = csv.reader(f)
                    data = list(reader)
                if not data:
                    return [], []
                return data[0], data[1:]
            except Exception as e:
                last_err = e
        raise last_err

    def _push_recent(self, path: str):
        recents = [p for p in self.prefs.get("recent_files", []) if p != path]
        recents.insert(0, path)
        self.prefs["recent_files"] = recents[:MAX_RECENTS]
        save_prefs(self.prefs)

    def _refresh_recent_menu(self):
        self.m_recent.clear()
        recents = self.prefs.get("recent_files", [])
        if not recents:
            act = QAction("（無）", self)
            act.setEnabled(False)
            self.m_recent.addAction(act)
        else:
            for p in recents:
                label = p if len(p) < 70 else "…" + p[-69:]
                act = QAction(label, self)
                act.triggered.connect(lambda checked=False, path=p: self.open_csv(path))
                self.m_recent.addAction(act)
            self.m_recent.addSeparator()
            clear_act = QAction("清除清單", self)
            clear_act.triggered.connect(self._clear_recents)
            self.m_recent.addAction(clear_act)

    def _clear_recents(self):
        self.prefs["recent_files"] = []
        save_prefs(self.prefs)
        self._refresh_recent_menu()

    # ---------- 表格過濾 ----------
    def apply_filter(self):
        self.proxy.setKeyword(self.ed_filter.text().strip())
        self._set_status("已套用過濾")

    def _focus_filter(self):
        self.ed_filter.setFocus()
        self.ed_filter.selectAll()

    # ---------- 右鍵選單（複製儲存格） ----------
    def _table_context_menu(self, pos):
        menu = QMenu(self)
        act_copy = QAction("複製儲存格文字", self)
        act_copy.triggered.connect(self._copy_cell_text)
        menu.addAction(act_copy)
        menu.exec_(self.table.viewport().mapToGlobal(pos))

    def _copy_cell_text(self):
        idx = self.table.currentIndex()
        if not idx.isValid():
            return
        # idx 是 proxy 索引，轉回 source
        sidx = self.proxy.mapToSource(idx)
        val = self.model.data(sidx, Qt.DisplayRole)
        QApplication.clipboard().setText("" if val is None else str(val))
        self._set_status("已複製儲存格文字")

    # ---------- 背景工作 ----------
    def cmd_start_worker(self):
        if self.thread and self.thread.isRunning():
            QMessageBox.information(self, "背景工作", "工作執行中，請先中止或等待完成。")
            return
        self.prg.setValue(0)
        self.thread = QThread(self)
        self.worker = BackgroundWorker(steps=180, delay_ms=20)
        self.worker.moveToThread(self.thread)

        self.thread.started.connect(self.worker.run)
        self.worker.signals.progress.connect(lambda v: self.prg.setValue(int(v * 100)))
        self.worker.signals.log.connect(self._log)
        self.worker.signals.error.connect(lambda e: QMessageBox.critical(self, "背景工作錯誤", e))
        self.worker.signals.done.connect(self._worker_done)

        self.thread.start()
        self._log("背景工作已開始…")
        self._set_status("背景工作執行中…")

    def _worker_done(self):
        self._set_status("背景工作已結束")
        if self.thread:
            self.thread.quit()
            self.thread.wait()
        self.thread = None
        self.worker = None

    def cmd_cancel_worker(self):
        if self.worker:
            self.worker.cancel()
            self._set_status("嘗試中止背景工作…")

    # ---------- 偏好 / 主題 / 全螢幕 ----------
    def cmd_preferences(self):
        dlg = PrefDialog(self.prefs, self)
        if dlg.exec() == QDialog.Accepted:
            self.prefs.update(dlg.result_prefs())
            save_prefs(self.prefs)
            apply_theme(self.app, self.prefs["theme"])
            self._set_status("已套用偏好設定")

    def toggle_theme(self):
        cur = self.prefs.get("theme", "light")
        self.prefs["theme"] = "dark" if cur == "light" else "light"
        save_prefs(self.prefs)
        apply_theme(self.app, self.prefs["theme"])

    def _toggle_fullscreen(self, force: bool = False):
        if force:
            self.showFullScreen()
            return
        if self.isFullScreen():
            self.showNormal()
        else:
            self.showFullScreen()

    # ---------- 其他 ----------
    def _log(self, text: str):
        self.txt_log.append(text)

    def _update_title(self):
        name = os.path.basename(self.current_file) if self.current_file else ""
        self.setWindowTitle(f"{APP_NAME} - {name}" if name else APP_NAME)

    def _set_status(self, text: str):
        self.statusBar().showMessage(text, 5000)

    def _restore_window_state(self):
        g = self.prefs.get("geometry")
        s = self.prefs.get("window_state")
        if g:
            try:
                self.restoreGeometry(bytes.fromhex(g))
            except Exception:
                pass
        if s:
            try:
                self.restoreState(bytes.fromhex(s))
            except Exception:
                pass

    def closeEvent(self, event):
        # 儲存幾何與狀態（避免全螢幕狀態造成還原問題，先確保為 Normal）
        was_full = self.isFullScreen()
        if was_full:
            self.showNormal()
        self.prefs["geometry"] = self.saveGeometry().toHex().data().decode("ascii")
        self.prefs["window_state"] = self.saveState().toHex().data().decode("ascii")
        save_prefs(self.prefs)
        super().closeEvent(event)

    def cmd_about(self):
        QMessageBox.information(self, "關於", f"{APP_NAME}\n\nPySide6 進階範例\n© 2025")

# -----------------------------
# 進入點
# -----------------------------
def main():
    app = QApplication(sys.argv)
    win = MainWindow(app)
    win.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
